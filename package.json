{
  "name": "dsh-cyber",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first standalone multi-agent workspace powered by DeepSeek Harness.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @dsh-cyber/web build && node scripts/check-build-budget.mjs",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:smoke": "playwright test e2e/conversation-control-runtime-lanes.spec.ts e2e/group-task-router.spec.ts e2e/work-system.spec.ts e2e/world-artifact-center.spec.ts e2e/role-runtime-permission.spec.ts e2e/i18n-locale.spec.ts e2e/creative-workshop-v2.spec.ts",
    "test:migration": "vitest run packages/persistence/tests/sqlite-store.test.ts packages/persistence/tests/conversation-queue-lease.test.ts packages/persistence/tests/completion-job-repository.test.ts packages/server/tests/local-backup-restore.test.ts",
    "test:schema": "vitest run packages/contracts/tests",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && pnpm --filter @dsh-cyber/web typecheck",
    "verify": "pnpm run typecheck && pnpm run test",
    "dsh-cyber": "node packages/cli/lib/bin.js"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.20.0",
    "happy-dom": "^20.11.6",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
